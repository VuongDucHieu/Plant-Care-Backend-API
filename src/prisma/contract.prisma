// use prisma-8

model User {
  id            String @id @onCreate(uuid())
  email         String @unique
  passwordHash  String

  sessions  Session[]
  plants    Plant[]

  createdAt temporal.CreatedAt
  updatedAt temporal.UpdatedAt
}

model Session {
  id                String @id @onCreate(uuid())
  userId            String
  expiresAt         DateTime
  revokeAt          DateTime?

  user          User @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  createdAt temporal.CreatedAt

  @@index([userId, revokeAt])
}

model RefreshToken {
  id String @id @onCreate(uuid())
  sessionId String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt  DateTime?

  session Session @relation(fields: [sessionId], references: [id])

  createdAt temporal.CreatedAt

  @@index([sessionId, revokedAt])
}

model Plant {
  id                      String @id @onCreate(uuid())
  ownerId                 String
  displayName             String
  scientificName          String?
  identificationSnapshot  Json?

  owner User @relation(fields: [ownerId], references: [id])

  createdAt temporal.CreatedAt
  updatedAt temporal.UpdatedAt

  @@index([ownerId, createdAt])
}