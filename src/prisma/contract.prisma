// use prisma-8

model User {
  id            String @id @onCreate(uuid())
  email         String @unique
  passwordHash  String

  sessions  Session[]
  plants    Plant[]

  createdAt temporal.CreatedAt
  updatedAt temporal.UpdatedAt
}

model Session {
  id                String @id @onCreate(uuid())
  userId            String
  expiresAt         DateTime
  lastActivityAt    DateTime
  revokeDAt         DateTime?
  revokedReason     String?

  user          User @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  createdAt temporal.CreatedAt

  @@index([userId, revokeDAt])
}

model RefreshToken {
  id String @id @onCreate(uuid())
  sessionId String
  parentTokenId String? @unique

  tokenHash     String @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  revokedAt     DateTime?
  revokedReason String?

  session Session @relation(fields: [sessionId], references: [id])

  parent RefreshToken? @relation("TokenLineage", fields: [parentTokenId], references: [id])
  children RefreshToken[] @relation("TokenLineage")

  createdAt temporal.CreatedAt

  @@index([sessionId, revokedAt])
}

model Plant {
  id                      String @id @onCreate(uuid())
  ownerId                 String
  displayName             String
  scientificName          String?
  identificationSnapshot  Json?

  owner User @relation(fields: [ownerId], references: [id])

  createdAt temporal.CreatedAt
  updatedAt temporal.UpdatedAt

  @@index([ownerId, createdAt])
}